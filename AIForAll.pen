    {
      "type": "note",
      "id": "7kNE4",
      "x": 0,
      "y": 1210,
      "name": "Flow: Course Discovery",
      "width": 340,
      "height": 0,
      "content": "FLOW: Course Discovery\n\nFrom: Landing Page / Login / Navbar\n\nActions:\n• Click course card → Course Learning\n• User dropdown → My Learning / Profile\n• Filter/Search → update results\n\nError States:\n• API load fails → ErrorState + Retry\n• Search/filter no results → EmptyState"
    },
    {
      "type": "note",
      "id": "OxClR",
      "x": 1540,
      "y": 1210,
      "name": "Flow: Course Learning",
      "width": 340,
      "height": 0,
      "content": "FLOW: Course Learning\n\nFrom: Course Discovery / My Learning\n\nActions:\n• Complete final question → Completion Modal\n• Back button → Course Discovery\n• Guest user → shows Guest Banner\n\nError States:\n• Video removed → VideoUnavailable\n• No quiz questions → show \"No quiz\" + complete\n• Quiz submit fails → Error Toast, keep answers"
    },
    {
      "type": "note",
      "id": "6vk09",
      "x": 3080,
      "y": 1110,
      "name": "Flow: My Learning",
      "width": 340,
      "height": 0,
      "content": "FLOW: My Learning\n\nFrom: User dropdown menu\n\nActions:\n• Click in-progress course → Course Learning\n• Click completed course → Course Learning\n• Switch tabs\n\nError States:\n• No courses in progress → EmptyState\n• No completed courses → EmptyState\n• No badges → EmptyState"
    },
    {
      "type": "note",
      "id": "wi45Q",
      "x": 4620,
      "y": 1110,
      "name": "Flow: Profile",
      "width": 340,
      "height": 0,
      "content": "FLOW: Profile\n\nFrom: User dropdown menu\n\nActions:\n• Click avatar → upload photo\n• Edit fields + Save → Toast (success/error)\n\nError States:\n• Avatar upload fails → Error Toast\n• Save fails → Error Toast, keep form data\n• Validation error → FormInput red border"
    },
    {
      "type": "note",
      "id": "5X5SF",
      "x": 6160,
      "y": 1740,
      "name": "Flow: Create/Edit Course",
      "width": 340,
      "height": 0,
      "content": "FLOW: Create/Edit Course\n\nFrom: Course Management\n\nActions:\n• Save → Toast + redirect\n• Add/Delete Question\n• Cancel → Course Management\n\nError States:\n• Required fields empty → FormInput error\n• Invalid YouTube URL → FormInput error\n• Save fails → Error Toast, keep form data"
    },
    {
      "type": "note",
      "id": "ueaPH",
      "x": 0,
      "y": 2610,
      "name": "Flow: Admin Dashboard",
      "width": 340,
      "height": 0,
      "content": "FLOW: Admin Dashboard\n\nFrom: Admin navbar\n\nActions:\n• View stats, trends, popular courses\n• Navigate via navbar\n\nError States:\n• No data yet → StatCards show 0\n• Analytics API fails → ErrorState + Retry"
    },
    {
      "type": "note",
      "id": "d2lbv",
      "x": 1540,
      "y": 2910,
      "name": "Flow: Course Management",
      "width": 340,
      "height": 0,
      "content": "FLOW: Course Management\n\nFrom: Admin navbar\n\nActions:\n• Create/Edit → Create/Edit Course\n• Delete → Confirm Dialog\n• Toggle publish → Toast\n• Search/filter\n\nError States:\n• No courses → EmptyState \"Create first course\"\n• Delete fails → Error Toast\n• Search no results → EmptyState"
    },
    {
      "type": "note",
      "id": "wc2yx",
      "x": 3080,
      "y": 2710,
      "name": "Flow: User Management",
      "width": 340,
      "height": 0,
      "content": "FLOW: User Management\n\nFrom: Admin navbar\n\nActions:\n• Expand row → view progress\n• Delete → Confirm Dialog\n• Search users\n\nError States:\n• No users → EmptyState\n• Delete fails → Error Toast\n• Search no results → EmptyState"
    },
    {
      "type": "note",
      "id": "GLKAR",
      "x": 4620,
      "y": 2710,
      "name": "Flow: Category Management",
      "width": 340,
      "height": 0,
      "content": "FLOW: Category Management\n\nFrom: Admin navbar\n\nActions:\n• Add/Edit Tool/Skill → inline form\n• Delete → Confirm Dialog\n• Drag to reorder\n\nError States:\n• Delete in-use item → Error Toast \"Used by X courses\"\n• Reorder fails → Error Toast, revert order"
    },
    {
      "type": "note",
      "id": "irXkO",
      "x": 0,
      "y": 5150,
      "name": "Flow: Landing Page",
      "width": 340,
      "height": 0,
      "content": "FLOW: Landing Page\n\nFrom: Direct URL / Search engine\n\nActions:\n• \"Get Started\" → Login Page\n• \"Log In\" → Login Page\n• \"Explore Courses\" → Course Discovery\n• Scroll → features, how it works, CTA"
    },
    {
      "type": "note",
      "id": "Y8rOo",
      "x": 1540,
      "y": 3910,
      "name": "Flow: Login Page",
      "width": 340,
      "height": 0,
      "content": "FLOW: Login Page\n\nFrom: Landing Page / Guest Banner\n\nActions:\n• Google OAuth → redirect to Course Discovery\n• Facebook OAuth → redirect to Course Discovery\n• \"Continue without signing in\" → Course Discovery\n\nError States:\n• OAuth fails → AlertBanner on page\n• User denies auth → AlertBanner \"Authorization denied\""
    },
    {
      "type": "note",
      "id": "XG4SW",
      "x": 3080,
      "y": 3510,
      "name": "Flow: Completion Modal",
      "width": 300,
      "height": 0,
      "content": "FLOW: Completion Modal\n\nFrom: Course Learning (final question)\n\nActions:\n• \"Browse Courses\" → Course Discovery\n• \"Next Course\" → next Course Learning"
    },
    {
      "type": "note",
      "id": "oHyWM",
      "x": 3780,
      "y": 3390,
      "name": "Flow: Confirm Dialog",
      "width": 300,
      "height": 0,
      "content": "FLOW: Confirm Dialog\n\nFrom: Any admin delete action\n\nActions:\n• \"Cancel\" → close modal\n• \"Delete\" → execute deletion + Toast"
    },
    {
      "type": "note",
      "id": "ZRFiO",
      "x": 4380,
      "y": 3200,
      "name": "Usage: Toast & Banner",
      "width": 300,
      "height": 0,
      "content": "USAGE NOTES\n\nToast: appears top-right after\nsave/delete/publish actions.\nAuto-dismiss after 5 seconds.\n\nGuest Banner: appears above video\nplayer for non-logged-in users only."
    },
