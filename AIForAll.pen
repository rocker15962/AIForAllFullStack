    {
      "type": "note",
      "id": "VmCcj",
      "x": 5280,
      "y": 3760,
      "name": "Flow: Question Editor Modal",
      "width": 300,
      "height": 0,
      "content": "FLOW: Question Editor Modal\n\nFrom: Create/Edit Course page\n\nTrigger:\n• \"+ Add Question\" → opens empty modal\n• \"Edit\" on question → opens pre-filled modal\n\nActions:\n• Toggle type → MC / Short Answer\n• Click radio → mark correct answer\n• \"Save Question\" → validate + close\n• \"Cancel\" / X → discard + close\n\nError States:\n• Empty question text → FormInput error\n• No correct answer selected → error hint\n• Save fails → Error Toast"
    }
