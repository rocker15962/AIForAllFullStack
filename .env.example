# PostgreSQL
POSTGRES_DB=aiforall
POSTGRES_USER=aiforall
POSTGRES_PASSWORD=aiforall

# Backend
DATABASE_URL=postgres://aiforall:aiforall@postgres:5432/aiforall?sslmode=disable
REDIS_URL=redis://redis:6379
GIN_MODE=debug
PORT=8080

# Auth (Google OAuth)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback
JWT_SECRET=your-jwt-secret-at-least-32-characters-long
FRONTEND_URL=http://localhost:3000

# AI grading of short answers (BR-09). Without a key, short-answer submissions
# return "please try again later" and are not scored.
ANTHROPIC_API_KEY=
# Optional: override the grading model (default claude-opus-5-5)
CLAUDE_GRADER_MODEL=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080
